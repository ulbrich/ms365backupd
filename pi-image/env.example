# Settings for `make image` (script/pi-image.sh). Shell syntax: KEY="value".
# This file is not committed (.gitignore). Variables given on the command line,
# e.g. `make image PI_USER=jan`, override the values here.

# WiFi. Leave WIFI_SSID empty for Ethernet only. WIFI_COUNTRY is the two-letter
# regulatory domain (DE, AT, CH, US, …).
WIFI_SSID=""
WIFI_PASSWORD=""
WIFI_COUNTRY="DE"

# Bonjour/mDNS name: `ssh foo.local` with MDNS_HOSTNAME="foo".
# Empty: the host name (PI_HOSTNAME) is announced, i.e. ms365backup.local.
#MDNS_HOSTNAME="foo"

# More settings (defaults shown), see README.md:
#PI_HOSTNAME="ms365backup"
#PI_USER="pi"
#PI_PASSWORD=""                              # empty: generated and printed by the build
#PI_SSH_KEY="pi-image/ssh/authorized_keys"
#PI_TIMEZONE="Europe/Berlin"                 # default: the time zone of this machine
#TS_AUTHKEY=""                               # Tailscale one-off auth key
#NODE_MAJOR="26"
#IMAGE_UPGRADE="1"
#IMAGE_COMPRESS="1"
